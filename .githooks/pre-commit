#!/bin/sh
# Lint every approach that ships a spec linter, against the STAGED content.
# Bypass deliberately with: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
status=0
for lint in "$root"/*/tools/speclint.py; do
  [ -f "$lint" ] || continue
  python3 "$lint" --staged || status=1
done
exit $status
